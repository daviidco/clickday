---
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<section class="hero">
  <div class="container">
    <h1 class="hero-title">
      Elige,<br />
      agenda y<br />
      haz click.
    </h1>

    <div class="hero-divider-wrap">
      <svg
        class="hero-divider-svg"
        viewBox="0 0 565 60"
        preserveAspectRatio="none"
        fill="none"
      >
        <path
          d="M0 1 H531 L565 51"
          stroke="#181818"
          stroke-width="2.5"
          fill="none"
          vector-effect="non-scaling-stroke"
        />
        <path
          d="M565 51 V6 M565 51 H535"
          stroke="#181818"
          stroke-width="2.5"
          fill="none"
          vector-effect="non-scaling-stroke"
        />
      </svg>
    </div>

    <div class="hero-bottom">
      <p class="hero-text">
        Estés donde estés,<br />
        que tus <strong>clientes</strong> siempre<br />
        puedan <strong>agendarte</strong>.
      </p>

      <a href={`${base}/create-account`} class="hero-cta">Comienza ahora</a>
    </div>
  </div>
</section>
