---
import icon from "../assets/logo/icon.svg";
---

<section class="features" id="funciones">
  <div class="container">
    <div class="features-card">
      <div class="features-headline">
        <h2>
          El <strong>click</strong> más importante del <strong>día.</strong>
        </h2>
      </div>

      <div class="features-cards">
        <div class="feature yellow">
          <span>Automatiza tus<br />citas sin<br />complicaciones</span>
          <span class="feature-icon">
            <span class="dot-grid">
              <span></span><span></span><span></span><span></span>
            </span>
          </span>
        </div>

        <div class="feature black">
          <span class="feature-icon">
            <svg width="42" height="42" viewBox="0 0 24 24" fill="none">
              <path d="M6 18L18 6M18 6H9M18 6V15" stroke="white" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          <span>Recibe<br />recordatorios<br />automáticos</span>
        </div>

        <div class="feature white">
          <span>Haz que te agenden<br />desde tu web</span>
          <span class="feature-icon">
            <img src={icon.src} width="60" height="60" alt="" />
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
