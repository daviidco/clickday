---
import logoFooter from "../assets/logo/logo-footer.svg";
---

<footer>
  <div class="container footer-grid">
    <div class="footer-brand">
      <div class="footer-logo">
        <img src={logoFooter.src} width={logoFooter.width} height={logoFooter.height} alt="ClickDay" />
      </div>

      <div class="footer-social">
        <a href="#" class="social-icon" aria-label="Facebook">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14 13.5h2.5l1-4H14v-2c0-1.03 0-2 2-2h1.5V2.14C17.17 2.1 15.95 2 14.66 2 11.98 2 10 3.66 10 6.7v2.8H7v4h3V22h4v-8.5Z" />
          </svg>
        </a>
        <a href="#" class="social-icon" aria-label="Correo">
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="4" width="20" height="16" rx="2" />
            <path d="m22 6-10 7L2 6" />
          </svg>
        </a>
        <a href="#" class="social-icon" aria-label="X (Twitter)">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.9 2H22l-7.6 8.7L23.3 22h-7l-5.5-6.7L4.5 22H1.4l8.1-9.3L1 2h7.2l5 6.1L18.9 2Zm-1.2 18h1.7L7.4 3.9H5.6L17.7 20Z" />
          </svg>
        </a>
      </div>
    </div>

    <div>
      <ul class="footer-links">
        <li><a href="#">Características</a></li>
        <li><a href="#">Planes</a></li>
        <li><a href="#">Asociados</a></li>
      </ul>
    </div>

    <div>
      <ul class="footer-links">
        <li><a href="#">Asistencia Comercial</a></li>
        <li><a href="#">Términos de Uso</a></li>
        <li><a href="#">Política de Privacidad</a></li>
        <li><a href="#">Estado</a></li>
      </ul>
    </div>
  </div>
</footer>
